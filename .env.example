# Server & Frontend URLs
PORT=3001
BFF_PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Registered New Deriv API Application Identifier (from https://developers.deriv.com)
# Required as the Deriv-App-ID header for Personal Access Tokens (PAT) AND as client_id for OAuth 2.0.
# Never commit live credentials.
DERIV_APP_ID=
DERIV_CLIENT_ID=
DERIV_REDIRECT_URI=http://localhost:3001/api/auth/callback
DERIV_SCOPES=trade

# Optional: Server-side Personal Access Token (pat_...) with `trade` scope for local trading.
# Kept strictly on the Node/Express server — never exposed to browser JavaScript or localStorage.
DERIV_PAT=

# Explicit logged-out quote currency for public indicative Rise/Fall proposals
VITE_PUBLIC_QUOTE_CURRENCY=USD

# ── Supabase Database & Persistence ──────────────────────────────────────────
# Project URL: https://<project-ref>.supabase.co (from Project Settings -> API)
SUPABASE_URL=

# Supabase Public Anonymous Key
SUPABASE_ANON_KEY=

# Supabase Service Role Key (Keep secret on server only)
SUPABASE_SERVICE_ROLE_KEY=
